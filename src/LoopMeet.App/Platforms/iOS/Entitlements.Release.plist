<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Required for APNs registration. Must match the provisioning profile:
	  use a distribution profile (App Store / Ad Hoc / TestFlight external)
	  when this is set to "production". Switch to "development" temporarily
	  if signing with a development profile during local debugging.
	-->
	<key>aps-environment</key>
	<string>production</string>
	<!--
	  Sign in with Apple capability. The "Default" scope enables the
	  standard Sign in with Apple flow. Must be matched by the provisioning
	  profile (Apple Developer Portal → App ID → enable "Sign in with Apple",
	  then regenerate + reinstall the Ad Hoc / App Store profile).
	-->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
