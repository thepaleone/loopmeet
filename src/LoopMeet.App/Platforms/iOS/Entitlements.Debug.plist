<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Debug entitlements: aps-environment=development pairs with an
	  iOS App Development provisioning profile + an Apple Development
	  signing cert. Tokens route through OneSignal's sandbox APNs.
	  Release builds use Entitlements.Release.plist with aps-environment=production.
	-->
	<key>aps-environment</key>
	<string>development</string>
	<!--
	  Sign in with Apple capability. The "Default" scope enables the
	  standard Sign in with Apple flow. Must be matched by the provisioning
	  profile (Apple Developer Portal → App ID → enable "Sign in with Apple",
	  then regenerate + reinstall the profile).
	-->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
