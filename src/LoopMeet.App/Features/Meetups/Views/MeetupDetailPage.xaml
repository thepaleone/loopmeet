<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LoopMeet.App.Features.Meetups.Views.MeetupDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Name="MeetupDetailPageRoot"
    Title="Meetup">

    <Grid RowDefinitions="Auto,*">
        <Grid
            Grid.Row="0"
            ColumnDefinitions="*,Auto"
            Padding="24,24,24,0"
            ColumnSpacing="12">
            <Label
                Text="Meetup"
                FontSize="24"
                FontAttributes="Bold"
                VerticalOptions="Center" />
            <!-- Owner-only: absent for everyone else, not disabled (FR-017). -->
            <Label
                Grid.Column="1"
                Text="✏️"
                FontSize="22"
                VerticalOptions="Center"
                IsVisible="{Binding IsOwner}"
                SemanticProperties.Description="Edit meetup">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding EditCommand}" />
                </Label.GestureRecognizers>
            </Label>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="24" Spacing="12">
                <ActivityIndicator
                    IsVisible="{Binding IsLoading}"
                    IsRunning="{Binding IsLoading}" />

                <!-- Loaded -->
                <Border
                    Padding="16"
                    IsVisible="{Binding IsLoaded}"
                    Style="{StaticResource BubbleCardBorderStyle}">
                    <VerticalStackLayout Spacing="16">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding Title}" FontSize="20" FontAttributes="Bold" />
                            <Label
                                Text="{Binding DateTimeDisplay}"
                                FontSize="14"
                                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Location" FontAttributes="Bold" FontSize="13" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label
                                    Text="{Binding LocationDisplay}"
                                    FontSize="14"
                                    VerticalOptions="Center"
                                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                                <Label
                                    Grid.Column="1"
                                    Text="📍"
                                    FontSize="20"
                                    VerticalOptions="Center"
                                    IsVisible="{Binding CanOpenLocation}"
                                    SemanticProperties.Description="Open location in maps">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenLocationCommand}" />
                                    </Label.GestureRecognizers>
                                </Label>
                            </Grid>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Group" FontAttributes="Bold" FontSize="13" />
                            <Label
                                Text="{Binding GroupName}"
                                FontSize="14"
                                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="2">
                            <Label Text="Organizer" FontAttributes="Bold" FontSize="13" />
                            <Label
                                Text="{Binding OrganizerDisplay}"
                                FontSize="14"
                                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Gone: deleted, or no longer upcoming -->
                <Label
                    Text="This meetup is no longer available."
                    FontSize="14"
                    IsVisible="{Binding IsNotFound}"
                    TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />

                <!-- Load failed -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasError}">
                    <Label
                        Text="We could not load this meetup. Please check your connection and try again."
                        FontSize="14"
                        TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                    <Button Text="Try Again" Command="{Binding LoadCommand}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
