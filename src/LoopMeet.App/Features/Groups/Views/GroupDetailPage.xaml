<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="LoopMeet.App.Features.Groups.Views.GroupDetailPage"
    x:Name="GroupDetailPageRoot"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:LoopMeet.App.Features.Groups.ViewModels"
    Title="{Binding GroupName}">

    <ContentPage.Resources>
        <!-- Resting look of the list toggle; the selected look comes from DataTriggers. -->
        <Style x:Key="MeetupListTabStyle" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <Style x:Key="MeetupListEmptyStyle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,8" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
        </Style>

        <!-- One card for both lists, so upcoming and past can never drift apart. -->
        <DataTemplate x:Key="MeetupCardTemplate">
            <SwipeView IsEnabled="{Binding BindingContext.IsOwner, Source={x:Reference GroupDetailPageRoot}}">
                <SwipeView.LeftItems>
                    <SwipeItems Mode="Execute">
                        <SwipeItemView
                            BackgroundColor="#DC2626"
                            Command="{Binding BindingContext.DeleteMeetupCommand, Source={x:Reference GroupDetailPageRoot}}"
                            CommandParameter="{Binding .}">
                            <Grid Padding="14,0">
                                <HorizontalStackLayout HorizontalOptions="Start" VerticalOptions="Center" Spacing="6">
                                    <Label Text="🗑" FontSize="16" TextColor="White" />
                                    <Label Text="Delete" FontAttributes="Bold" TextColor="White" />
                                </HorizontalStackLayout>
                            </Grid>
                        </SwipeItemView>
                    </SwipeItems>
                </SwipeView.LeftItems>

                <Border
                    Style="{StaticResource BubbleCardCompactBorderStyle}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                    Padding="12,10"
                    Margin="0,0,0,4">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="14,18,16,20" />
                    </Border.StrokeShape>
                    <!-- Opens details for every member, owner or not
                         (FR-008); editing is offered there, gated
                         on ownership. -->
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer
                            Command="{Binding BindingContext.OpenMeetupDetailCommand, Source={x:Reference GroupDetailPageRoot}}"
                            CommandParameter="{Binding .}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="15" LineBreakMode="TailTruncation" />
                        <Label Text="{Binding DateTimeDisplay}" FontSize="13"
                            TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray300}}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding LocationDisplay}" FontSize="13"
                                VerticalOptions="Center"
                                TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                            <Label Grid.Column="1" Text="📍" FontSize="16"
                                VerticalOptions="Center"
                                IsVisible="{Binding CanOpenLocation}"
                                SemanticProperties.Description="Open location in maps">
                                <Label.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding BindingContext.OpenLocationCommand, Source={x:Reference GroupDetailPageRoot}}"
                                        CommandParameter="{Binding .}" />
                                </Label.GestureRecognizers>
                            </Label>
                        </Grid>
                        <!-- Desktop delete button fallback -->
                        <HorizontalStackLayout
                            Spacing="8"
                            IsVisible="{OnIdiom Phone=False, Tablet=False, Desktop=True, TV=True}">
                            <Button Text="🗑 Delete"
                                BackgroundColor="#DC2626" TextColor="White" FontSize="12" Padding="8,4"
                                Command="{Binding BindingContext.DeleteMeetupCommand, Source={x:Reference GroupDetailPageRoot}}"
                                CommandParameter="{Binding .}"
                                IsVisible="{Binding BindingContext.IsOwner, Source={x:Reference GroupDetailPageRoot}}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </SwipeView>
        </DataTemplate>
    </ContentPage.Resources>

    <Grid>
        <RefreshView Command="{Binding RefreshMeetupsCommand}" IsRefreshing="{Binding IsRefreshing}">
            <ScrollView x:Name="ContentScroll" Scrolled="OnContentScrolled">
                <VerticalStackLayout Padding="24,24,24,120" Spacing="12">
                    <Label Text="{Binding GroupName}" FontSize="24" FontAttributes="Bold" />
                    <Button Text="Edit Group" Command="{Binding EditGroupCommand}" IsVisible="{Binding IsOwner}" />
                    <Label Text="Members" FontAttributes="Bold" FontSize="16" Margin="0,8,0,4" />
                    <FlexLayout
                        BindableLayout.ItemsSource="{Binding Members}"
                        Wrap="Wrap"
                        Direction="Row"
                        JustifyContent="Start"
                        AlignItems="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    Style="{StaticResource BubbleCardCompactBorderStyle}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray900}}"
                                    Padding="10,8"
                                    Margin="0,0,8,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14,18,16,20" />
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                        <!-- Avatar circle -->
                                        <Border
                                            WidthRequest="40" HeightRequest="40"
                                            BackgroundColor="{StaticResource Gray400}"
                                            StrokeThickness="0">
                                            <Border.StrokeShape><Ellipse /></Border.StrokeShape>
                                            <Grid WidthRequest="40" HeightRequest="40">
                                                <Label
                                                    Text="{Binding Initial}"
                                                    FontSize="15" FontAttributes="Bold"
                                                    TextColor="White"
                                                    HorizontalOptions="Center" VerticalOptions="Center" />
                                                <Image
                                                    Source="{Binding AvatarUrl}"
                                                    Aspect="AspectFill"
                                                    IsVisible="{Binding HasAvatar}" />
                                            </Grid>
                                        </Border>
                                        <!-- Member name -->
                                        <Label
                                            Text="{Binding DisplayName}"
                                            FontSize="12"
                                            MaximumWidthRequest="80"
                                            HorizontalOptions="Center"
                                            HorizontalTextAlignment="Center"
                                            LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <!-- Meetups: Upcoming / Past toggle (always visible) -->
                    <Border
                        Padding="4"
                        Margin="0,8,0,4"
                        StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                            <Button
                                Text="Upcoming Meetups"
                                Style="{StaticResource MeetupListTabStyle}"
                                Command="{Binding SelectMeetupListCommand}"
                                CommandParameter="{x:Static vm:MeetupListMode.Upcoming}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsUpcomingSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="TextColor" Value="{StaticResource White}" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                            <Button
                                Grid.Column="1"
                                Text="Past Meetups"
                                Style="{StaticResource MeetupListTabStyle}"
                                Command="{Binding SelectMeetupListCommand}"
                                CommandParameter="{x:Static vm:MeetupListMode.Past}">
                                <Button.Triggers>
                                    <DataTrigger TargetType="Button" Binding="{Binding IsPastSelected}" Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}" />
                                        <Setter Property="TextColor" Value="{StaticResource White}" />
                                        <Setter Property="FontAttributes" Value="Bold" />
                                    </DataTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Upcoming list -->
                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding Meetups}"
                        BindableLayout.ItemTemplate="{StaticResource MeetupCardTemplate}"
                        Spacing="8"
                        IsVisible="{Binding IsUpcomingSelected}" />
                    <Label
                        Text="No upcoming meetups"
                        Style="{StaticResource MeetupListEmptyStyle}"
                        IsVisible="{Binding ShowUpcomingEmpty}" />

                    <!-- Past list: newest first, more pages load near the bottom -->
                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding PastMeetups}"
                        BindableLayout.ItemTemplate="{StaticResource MeetupCardTemplate}"
                        Spacing="8"
                        IsVisible="{Binding IsPastSelected}" />
                    <Label
                        Text="No past meetups yet"
                        Style="{StaticResource MeetupListEmptyStyle}"
                        IsVisible="{Binding ShowPastEmpty}" />
                    <ActivityIndicator
                        HorizontalOptions="Center"
                        IsRunning="{Binding IsLoadingMorePast}"
                        IsVisible="{Binding IsLoadingMorePast}" />
                    <Label
                        Text="Couldn't load more — tap to retry"
                        Style="{StaticResource MeetupListEmptyStyle}"
                        IsVisible="{Binding ShowLoadMoreError}">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LoadMorePastMeetupsCommand}" />
                        </Label.GestureRecognizers>
                    </Label>
                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>

        <!-- Add Meetup FAB (above invite) -->
        <Button
            VerticalOptions="End"
            HorizontalOptions="End"
            Margin="0,0,16,100"
            WidthRequest="56"
            HeightRequest="56"
            CornerRadius="28"
            ImageSource="ic_add_meetup.png"
            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
            Command="{Binding AddMeetupCommand}"
            IsVisible="{Binding IsOwner}" />

        <!-- Invite Member FAB -->
        <Button
            VerticalOptions="End"
            HorizontalOptions="End"
            Margin="0,0,16,32"
            WidthRequest="56"
            HeightRequest="56"
            CornerRadius="28"
            ImageSource="ic_invite.png"
            BackgroundColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource PrimaryDark}}"
            Command="{Binding InviteMemberCommand}"
            IsVisible="{Binding IsOwner}" />
    </Grid>
</ContentPage>
