// The loopmeet.io site (017 research D11): a Worker with static assets and no script.
// Workers Builds deploys main with `wrangler deploy` and other branches with `wrangler preview`,
// which requires the previews block even when it's empty.
{
  "name": "loopmeet-account",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./web/public"
  },
  "previews": {}
}
