<?xml version="1.0" encoding="utf-8" ?>
<!--
  REFERENCE ONLY (feature 022 design input). Not compiled; the spec/plan decide the final XAML.
  Proposed ProfilePage layout.
  Fixes the clipping: every action is a full-width row, so nothing
  can run off the right edge at any width or orientation.
  ViewModel additions needed:
    - bool HasUnsavedChanges (DisplayName != saved name) -> Save CanExecute
    - string MemberSinceText ("Member since Nov 2026"), string GroupCountText ("5 groups")
    - string NotificationStatusText ("On" / "Off"), from NotificationPermissionService.CurrentState
-->
<ContentPage
    x:Class="LoopMeet.App.Features.Profile.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Profile"
    BackgroundColor="{StaticResource AppBackgroundColor}">

    <ContentPage.Resources>
        <!-- Section header: small caps-style label above each card -->
        <Style x:Key="SectionLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="0.8" />
            <Setter Property="TextTransform" Value="Uppercase" />
            <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
            <Setter Property="Margin" Value="6,20,6,8" />
        </Style>
        <!-- One tappable settings row: [icon tile] [text, fills] [chevron] -->
        <Style x:Key="SettingsRow" TargetType="Grid">
            <Setter Property="ColumnDefinitions" Value="40,*,Auto" />
            <Setter Property="ColumnSpacing" Value="14" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="MinimumHeightRequest" Value="56" />
        </Style>
        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="WidthRequest" Value="34" />
            <Setter Property="HeightRequest" Value="34" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape" Value="RoundRectangle 10" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="RowTitle" TargetType="Label">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="{StaticResource TextMain}" />
            <Setter Property="LineBreakMode" Value="TailTruncation" />
        </Style>
        <Style x:Key="RowSubtitle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{StaticResource TextMuted}" />
        </Style>
        <Style x:Key="Chevron" TargetType="Label">
            <Setter Property="Text" Value="›" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="TextColor" Value="{StaticResource Gray400}" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
        <Style x:Key="RowDivider" TargetType="BoxView">
            <Setter Property="HeightRequest" Value="1" />
            <Setter Property="Color" Value="{StaticResource Gray100}" />
        </Style>
        <Color x:Key="Terracotta">#C0573E</Color>
    </ContentPage.Resources>

    <!-- Same header pattern as Create/Edit Meetup (011): title + icon-only save in a
         row outside the ScrollView, so the keyboard can't cover it. -->
    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="20,16,20,0" ColumnSpacing="12"
              MaximumWidthRequest="600">
            <Label Text="Profile" FontSize="24" FontAttributes="Bold" VerticalOptions="Center" />
            <ImageButton Grid.Column="1" Source="ic_save.png" WidthRequest="40" HeightRequest="40" Padding="9"
                         CornerRadius="14" BackgroundColor="{StaticResource Primary}"
                         Command="{Binding SaveProfileCommand}"
                         SemanticProperties.Description="Save profile" />
        </Grid>

    <ScrollView Grid.Row="1">
        <!-- MaximumWidthRequest keeps rows readable in landscape / on tablets -->
        <VerticalStackLayout
            Padding="20,16,20,120"
            MaximumWidthRequest="600"
            HorizontalOptions="Fill">

            <!-- ===== Header card ===== -->
            <Border Style="{StaticResource BubbleCardBorderStyle}" Padding="20,22,20,18">
                <VerticalStackLayout Spacing="2" HorizontalOptions="Center">
                    <Grid WidthRequest="96" HeightRequest="96" HorizontalOptions="Center">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding PickAvatarCommand}" />
                        </Grid.GestureRecognizers>
                        <Border StrokeThickness="0" StrokeShape="Ellipse">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{StaticResource Primary}" Offset="0" />
                                    <GradientStop Color="{StaticResource Secondary}" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Label Text="{Binding UserInitial}" FontSize="42" FontAttributes="Bold"
                                       TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                                <Image Source="{Binding AvatarUrl}" Aspect="AspectFill" IsVisible="{Binding HasAvatar}" />
                            </Grid>
                        </Border>
                        <!-- "Change photo" badge -->
                        <Border WidthRequest="34" HeightRequest="34" StrokeThickness="0" StrokeShape="Ellipse"
                                BackgroundColor="White" HorizontalOptions="End" VerticalOptions="End"
                                Margin="0,0,-2,-2">
                            <Border.Shadow><Shadow Brush="Black" Opacity="0.15" Radius="6" Offset="0,2" /></Border.Shadow>
                            <Image Source="ic_camera.png" WidthRequest="18" HeightRequest="18" />
                        </Border>
                        <ActivityIndicator IsRunning="{Binding IsUploading}" IsVisible="{Binding IsUploading}" Color="White" />
                    </Grid>

                    <Label Text="{Binding DisplayName}" FontSize="21" FontAttributes="Bold"
                           HorizontalTextAlignment="Center" Margin="0,12,0,0" LineBreakMode="TailTruncation" />
                    <Label Text="{Binding Email}" FontSize="14" TextColor="{StaticResource TextMuted}"
                           HorizontalTextAlignment="Center" LineBreakMode="MiddleTruncation" />

                    <!-- FlexLayout wraps the chips instead of clipping them -->
                    <FlexLayout Wrap="Wrap" JustifyContent="Center" Margin="0,12,0,0">
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 999" BackgroundColor="#FFF1E0"
                                Padding="12,5" Margin="4">
                            <Label Text="{Binding MemberSinceText}" FontSize="13" FontAttributes="Bold" TextColor="#8A4B00" />
                        </Border>
                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 999" BackgroundColor="#FFF1E0"
                                Padding="12,5" Margin="4">
                            <Label Text="{Binding GroupCountText}" FontSize="13" FontAttributes="Bold" TextColor="#8A4B00" />
                        </Border>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <!-- ===== Account ===== -->
            <Label Text="Account" Style="{StaticResource SectionLabel}" />
            <Border Style="{StaticResource BubbleCardBorderStyle}" Padding="0">
                <VerticalStackLayout>
                    <!-- Display name (inline edit) -->
                    <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="40,*">
                        <Border Style="{StaticResource IconTile}" BackgroundColor="#FFF1E0">
                            <Image Source="tab_profile.svg" WidthRequest="18" HeightRequest="18" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="0">
                            <Label Text="Display name" FontSize="12" FontAttributes="Bold" TextColor="{StaticResource TextMuted}" />
                            <Entry Text="{Binding DisplayName}" Placeholder="Display name" ReturnType="Done"
                                   ReturnCommand="{Binding SaveProfileCommand}" />
                        </VerticalStackLayout>
                    </Grid>
                    <BoxView Style="{StaticResource RowDivider}" />

                    <!-- Change password (hidden for Google/Apple accounts) -->
                    <Grid Style="{StaticResource SettingsRow}" IsVisible="{Binding CanChangePassword}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenPasswordChangeCommand}" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource IconTile}" BackgroundColor="#FFF1E0">
                            <Image Source="ic_change_pwd.png" WidthRequest="18" HeightRequest="18" />
                        </Border>
                        <Label Grid.Column="1" Text="Change password" Style="{StaticResource RowTitle}" VerticalOptions="Center" />
                        <Label Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDivider}" IsVisible="{Binding CanChangePassword}" />

                    <!-- Notifications -->
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenNotificationSettingsCommand}" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource IconTile}" BackgroundColor="#FFE6EE">
                            <Image Source="ic_notification_bell_fallback.png" WidthRequest="18" HeightRequest="18" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Notifications" Style="{StaticResource RowTitle}" />
                            <Label Text="{Binding NotificationStatusText, StringFormat='{0} · Manage in device settings'}"
                                   Style="{StaticResource RowSubtitle}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ===== Session / danger zone ===== -->
            <Border Style="{StaticResource BubbleCardBorderStyle}" Padding="0" Margin="0,16,0,0">
                <VerticalStackLayout>
                    <Grid Style="{StaticResource SettingsRow}" ColumnDefinitions="40,*">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding LogoutCommand}" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource IconTile}" BackgroundColor="{StaticResource Gray100}">
                            <Image Source="ic_logout.png" WidthRequest="18" HeightRequest="18" />
                        </Border>
                        <Label Grid.Column="1" Text="Log out" Style="{StaticResource RowTitle}" VerticalOptions="Center" />
                    </Grid>
                    <BoxView Style="{StaticResource RowDivider}" />
                    <Grid Style="{StaticResource SettingsRow}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DeleteAccountCommand}" />
                        </Grid.GestureRecognizers>
                        <Border Style="{StaticResource IconTile}" BackgroundColor="#FBE9E4">
                            <Image Source="ic_delete_account.png" WidthRequest="18" HeightRequest="18" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                            <Label Text="Delete account" Style="{StaticResource RowTitle}" TextColor="{StaticResource Terracotta}" />
                            <!-- No day count here: the grace period already lives in two places (CLAUDE.md, 016) -->
                            <Label Text="Review what's deleted before you confirm" Style="{StaticResource RowSubtitle}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2" Style="{StaticResource Chevron}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="{Binding StatusMessage}" IsVisible="{Binding ShowStatus}"
                   HorizontalTextAlignment="Center" Margin="0,12,0,0" />
            <Label Text="{Binding VersionText}" FontSize="12" HorizontalOptions="Center" Margin="0,22,0,0"
                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
